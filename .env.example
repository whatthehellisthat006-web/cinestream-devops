# Copy this file to .env and fill in real values (never commit .env)
SERVER_PORT=8081

# Database
MYSQL_DATABASE=cinestream_db
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=cinestream
MYSQL_PASSWORD=change_me_db_password

# Spring Boot Datasource
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/cinestream_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=cinestream
SPRING_DATASOURCE_PASSWORD=change_me_db_password

# JWT (minimum 32 characters)
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# Optional Cloudflare R2 (leave empty to use built-in demo stream fallback)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cinestream-videos
R2_ENDPOINT=
